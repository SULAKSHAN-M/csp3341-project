@page
@model TranscriptModel
@{
    ViewData["Title"] = "Transcript Lookup";
}

<h1 class="page-title">Transcript Lookup</h1>
<p class="page-subtitle">Enter a student ID (format: starts with "10", e.g. 10730907) to view their transcript.</p>

<form method="get" class="section-card" style="max-width: 480px; padding: 16px 24px;">
    <input class="search-box" type="text" name="StudentId" value="@Model.StudentId"
           placeholder="e.g. 10730907" style="margin-bottom: 12px;" />
    <button type="submit" class="badge" style="border:none; cursor:pointer; padding: 10px 18px; font-size: 0.9rem;">
        Look up transcript
    </button>
</form>

@if (Model.Searched)
{
    @if (Model.Found is null)
    {
        <div class="section-card">No student found with ID "@Model.StudentId".</div>
    }
    else
    {
        <div class="section-card">
            <h2>@Model.Found.Name <span class="badge badge-muted">@Model.Found.StudentId</span></h2>
            <p class="page-subtitle" style="margin-bottom: 14px;">
                @Model.Found.Course &middot; WAM: <strong>@Model.Found.Wam.ToString("0.0")</strong>
            </p>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Semester</th>
                        <th>Mark</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Found.Enrolments)
                {
                    <tr>
                        <td>@e.UnitCode</td>
                        <td>@e.Semester</td>
                        <td>@e.Mark</td>
                        <td><span class="@TranscriptModel.GradeCssClass(e.Grade)">@e.Grade</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
